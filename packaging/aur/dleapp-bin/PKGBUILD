# Maintainer: Alexis Brignoni <https://github.com/abrignoni>
# Prebuilt DLEAPP release (frozen AppImage from GitHub Releases).
# For the latest commit instead, use dleapp-git.
pkgname=dleapp-bin
pkgver=2026.4.5
pkgrel=1
pkgdesc='Desktop Logs Events And Protobuf Parser (prebuilt release)'
arch=('x86_64' 'aarch64')
url='https://github.com/abrignoni/DLEAPP'
license=('MIT')
provides=('dleapp')
conflicts=('dleapp' 'dleapp-git')
options=('!strip')
source_x86_64=("DLEAPP-${pkgver}-linux-x64.AppImage::https://github.com/abrignoni/DLEAPP/releases/download/v${pkgver}/DLEAPP-${pkgver}-linux-x64.AppImage")
source_aarch64=("DLEAPP-${pkgver}-linux-arm64.AppImage::https://github.com/abrignoni/DLEAPP/releases/download/v${pkgver}/DLEAPP-${pkgver}-linux-arm64.AppImage")
sha256sums_x86_64=('15e584d32f45d06a17ddcb62bf447f1c63a988c928fec554d29c5d03b8a15169')
sha256sums_aarch64=('e9f6928df29be97c53de1b9aa36ec0524a45b6c8859acc321b70a778ebe25818')
# Icon and desktop entry ship with the upstream repo (packaging/linux/).
# They come from main rather than the release tag: tiny stable files, pinned
# by digest below (a change fails closed at build time), refreshed on every
# release by aur-publish.yml.
source+=("dleapp.desktop::https://raw.githubusercontent.com/abrignoni/DLEAPP/main/packaging/linux/dleapp.desktop"
         "dleapp.png::https://raw.githubusercontent.com/abrignoni/DLEAPP/main/assets/icon.png")
sha256sums=('d81f2e8b23c9c0674b997bd100acc38180d147f6763be3c14d60279a3b85ba38'
            'caec80b8dc2f1d598da1c99ffec91f4069501fc3bbd782d615fde76984c2dd37')

package() {
  cd "$srcdir"
  local appimage
  appimage="$(ls DLEAPP-"${pkgver}"-linux-*.AppImage)"
  install -Dm755 "$appimage" "$pkgdir/opt/dleapp/dleapp.AppImage"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/dleapp/dleapp.AppImage "$pkgdir/usr/bin/dleapp"
  install -Dm644 dleapp.desktop "$pkgdir/usr/share/applications/dleapp.desktop"
  install -Dm644 dleapp.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/dleapp.png"
  install -Dm644 dleapp.png "$pkgdir/usr/share/pixmaps/dleapp.png"
}
